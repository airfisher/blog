---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate } from '../site';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base>
  <section class="intro">
    <p class="eyebrow"><span aria-hidden="true">~/</span> airfisher / notes</p>
    <h1>工程手记<span class="title-period" aria-hidden="true">.</span></h1>
    <p class="intro-description">记录技术实践、问题与思考。</p>
  </section>
  <section aria-labelledby="posts-heading" class="post-list">
    <div class="section-heading"><h2 id="posts-heading"><span aria-hidden="true">#</span> 文章索引</h2><span>{String(posts.length).padStart(2, '0')} entries</span></div>
    {posts.map(post => <article class="post-row">
      <time class="post-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <div class="post-summary">
        <h3><a href={`/posts/${post.id}/`}>{post.data.title}<span class="post-arrow" aria-hidden="true">↗</span></a></h3>
        <p>{post.data.description}</p>
        {post.data.tags.length > 0 && <div class="post-tags">{post.data.tags.map(tag => <span class="tag">{tag}</span>)}</div>}
      </div>
    </article>)}
    {posts.length === 0 && <p class="empty">暂无文章。</p>}
  </section>
</Base>
