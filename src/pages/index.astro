---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate } from '../site';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base>
  <section class="pt-[42px] pb-9 sm:pt-15 sm:pb-12">
    <p class="mb-5 font-mono text-[13px] leading-[1.7] text-muted"><span class="text-accent" aria-hidden="true">~/</span> airfisher / notes</p>
    <h1 class="text-[clamp(30px,4vw,38px)] leading-normal font-semibold tracking-[-.8px]">工程手记<span class="ml-[5px] font-mono text-accent" aria-hidden="true">.</span></h1>
    <p class="mt-3 text-base leading-[1.9] text-muted">记录技术实践、问题与思考。</p>
  </section>
  <section aria-labelledby="posts-heading">
    <div class="flex items-center justify-between gap-4 border-b border-line pb-[15px]"><h2 id="posts-heading" class="text-sm font-medium"><span class="mr-2 font-mono text-accent" aria-hidden="true">#</span> 文章索引</h2><span class="font-mono text-xs leading-[1.7] text-muted">{String(posts.length).padStart(2, '0')} entries</span></div>
    {posts.map(post => <article class="grid grid-cols-1 gap-2 border-b border-line py-[22px] sm:grid-cols-[120px_minmax(0,1fr)] sm:gap-7 sm:py-[25px]">
      <time class="pt-[3px] font-mono text-xs leading-[1.8] text-muted sm:text-[13px]" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <div class="min-w-0">
        <h3 class="mb-[7px] text-[19px] leading-relaxed font-semibold"><a class="group flex items-baseline justify-between gap-5 wrap-anywhere" href={`/posts/${post.id}/`}>{post.data.title}<span class="font-mono text-lg text-muted group-hover:text-accent" aria-hidden="true">↗</span></a></h3>
        <p class="text-[15px] leading-[1.85] wrap-anywhere text-muted">{post.data.description}</p>
        {post.data.tags.length > 0 && <div class="mt-3 flex flex-wrap gap-3">{post.data.tags.map(tag => <span class="text-xs leading-[1.7] text-muted before:mr-[3px] before:font-mono before:text-accent before:content-['#']">{tag}</span>)}</div>}
      </div>
    </article>)}
    {posts.length === 0 && <p class="py-6 text-muted">暂无文章。</p>}
  </section>
</Base>
