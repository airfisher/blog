---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate } from '../site';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base>
  <section class="intro">
    <p class="eyebrow">NOTES & THOUGHTS</p>
    <h1>把想法写下来，<br /><span>让时间留下痕迹。</span></h1>
    <p class="intro-description">关于技术、生活，以及值得记录的想法。</p>
  </section>
  <section aria-labelledby="posts-heading" class="post-list">
    <div class="section-heading"><h2 id="posts-heading">文章</h2><span>{String(posts.length).padStart(2, '0')} 篇记录</span></div>
    {posts.map((post, index) => <article class="post-row">
      <span class="post-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <div><div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.tags.map(tag => <span class="tag">{tag}</span>)}</div>
      <h3><a href={`/posts/${post.id}/`}>{post.data.title}<span aria-hidden="true">↗</span></a></h3>
      <p>{post.data.description}</p></div>
    </article>)}
    {posts.length === 0 && <p class="empty">第一篇文章，正在酝酿中。</p>}
  </section>
</Base>
