---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDateDot } from '../site';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base>
  <!-- Hero -->
  <section class="grid items-center gap-12 pt-14 pb-2 sm:pt-20 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
    <div>
      <p class="text-xs font-medium tracking-[0.28em] text-accent uppercase">01 — A PERSONAL BLOG</p>
      <p class="mt-6 text-sm text-muted sm:text-[15px]">软件工程师 · 视觉 / 交互 / AI</p>
      <h1 class="mt-4 font-serif text-[clamp(34px,4.6vw,52px)] leading-[1.18] font-semibold text-accent">I build interfaces and write about the craft.</h1>
      <hr class="mt-9 w-16 border-0 border-t border-line" />
    </div>
    <img
      src="/images/hero-collage.png"
      alt="拼贴画：撕纸风景与植物标本，手写 A Quieter Internet，以及叠放的 INTERFACES、IDEAS、AND、A BRIGHTER TOMORROW"
      width="490"
      height="440"
      loading="eager"
      class="w-full max-w-[490px] justify-self-center lg:justify-self-end"
    />
  </section>

  <!-- Featured posts -->
  <section class="mt-20 sm:mt-28" aria-labelledby="featured-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-line pb-4">
      <h2 id="featured-heading" class="font-serif text-2xl font-semibold tracking-tight text-ink sm:text-[28px]">02 — 精选文章</h2>
      <a class="text-sm text-muted transition-colors hover:text-accent" href="/posts/">View all posts <span aria-hidden="true">→</span></a>
    </div>
    <div class="mt-7 space-y-5">
      {posts.map(post => (
        <a
          class="group flex items-start gap-4 rounded-md bg-surface/70 px-5 py-5 transition-colors hover:bg-surface sm:gap-6 sm:px-7 sm:py-6"
          href={`/posts/${post.id}/`}
        >
          <time class="pt-1.5 font-mono text-[13px] whitespace-nowrap text-muted" datetime={post.data.date.toISOString()}>{formatDateDot(post.data.date)}</time>
          <span class="mt-1.5 hidden h-4 w-px shrink-0 bg-line sm:block" aria-hidden="true"></span>
          <span class="min-w-0 flex-1">
            <span class="block font-serif text-lg leading-snug font-semibold text-ink sm:text-xl">{post.data.title}</span>
            <span class="mt-1.5 block text-sm leading-relaxed text-muted">{post.data.description}</span>
          </span>
          <span class="pt-1 text-accent transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      ))}
      {posts.length === 0 && <p class="py-6 text-muted">暂无文章。</p>}
    </div>
  </section>
</Base>
