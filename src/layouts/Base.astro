---
import '../styles/global.css';
import { site } from '../site';
import ThemeToggle from '../components/ThemeToggle.astro';
import ThemeScript from '../components/ThemeScript.astro';
interface Props { title?: string; description?: string; profile?: boolean; }
const { title, description = site.description, profile = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#fafafa" />
    <ThemeScript />
  </head>
  <body>
    <a class="absolute -top-24 left-5 z-10 bg-surface p-3 focus:top-2.5" href="#main">跳转到正文</a>
    <div class:list={["mx-auto flex min-h-svh flex-col px-6 sm:px-10", profile ? "max-w-[640px]" : "max-w-[880px]"]}>
      {profile ? <header class="flex justify-end pt-6 sm:pt-8"><ThemeToggle /></header> : <header class="flex flex-wrap items-center justify-between gap-3.5 border-b border-line py-4 font-mono sm:gap-6 sm:py-[25px]">
        <a class="flex items-center gap-2 text-[15px] font-semibold sm:gap-3 sm:text-base" href="/" aria-label="Airfisher 首页"><span class="font-normal text-accent" aria-hidden="true">[a]</span><span>airfisher</span></a>
        <nav class="flex flex-wrap items-center gap-4 text-sm text-muted sm:gap-6 [&>a]:py-2 [&>a[aria-current=page]]:text-ink [&>a[aria-current=page]]:underline [&>a[aria-current=page]]:decoration-accent [&>a[aria-current=page]]:underline-offset-8" aria-label="主导航"><a href="/posts/" aria-current={Astro.url.pathname.startsWith('/posts') ? 'page' : undefined}>文章</a><a href="https://github.com/airfisher">GitHub <span aria-hidden="true">↗</span></a><a href="/rss.xml">RSS</a><ThemeToggle /></nav>
      </header>}
      <main id="main" class="flex-1"><slot /></main>
      <footer class:list={["mt-16 flex gap-5 pb-7 font-mono text-xs leading-[1.8] text-muted", profile ? "justify-center pt-6" : "flex-wrap justify-between border-t border-line pt-[22px] sm:mt-24"]}><span>© {new Date().getFullYear()} {site.name}</span></footer>
    </div>
  </body>
</html>
